{
  "name": "desk-buddy",
  "productName": "Desk Buddy",
  "version": "0.3.0",
  "description": "A cute walking desktop buddy for macOS that reminds you of your Google Calendar and reschedules your day with Claude when you talk to it.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "setup:voice": "bash scripts/setup-voice.sh",
    "dist": "electron-builder --mac"
  },
  "keywords": ["desktop-pet", "electron", "claude", "google-calendar", "macos"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "googleapis": "^185.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dilip.deskbuddy",
    "productName": "Desk Buddy",
    "files": ["main.js", "preload.js", "src/**", "renderer/**", "package.json"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Desk Buddy listens when you click it so you can talk to Claude."
      }
    }
  }
}
